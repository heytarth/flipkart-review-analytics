# Generated data -- all of this rebuilds from scripts/ in a few minutes.
# ~109 MB; never commit it.
data/processed/

# Raw dataset (~30 MB). Download from Kaggle instead -- see README.
data/raw/*.csv

# Trained model artefacts -- regenerated by scripts/02
outputs/models/*.pkl

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Never commit anything holding a session cookie or credential
*scraper*draft*
*.env
